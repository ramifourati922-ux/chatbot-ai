# Copier ce fichier vers .env et renseigner les valeurs.
# .env est dans .gitignore — ne jamais commit de vraies clés/secrets.

APP_NAME="Liss Strike Bot"
DEBUG=True
# Journal des requêtes SQL, pour déboguer uniquement (désactivé par défaut) ;
# même activé, les valeurs des requêtes (messages, numéros) ne s'affichent pas.
SQL_ECHO=false
SECRET_KEY="change-moi-en-production"

# Base de données
DATABASE_URL=postgresql+asyncpg://chatbot_user:secret123@localhost:5432/chatbot_db
POSTGRES_DB=chatbot_db
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=secret123

# Redis
REDIS_URL=redis://localhost:6379

# Groq — clé gratuite sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ChromaDB (tourne via docker-compose sur le port 8001)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=liss_strike_kb

# Embeddings (local, gratuit, multilingue)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# RAG — Advanced RAG (voir CHANGELOG_ADVANCED_RAG.md). Valeurs par défaut
# de app/config.py : ces lignes sont optionnelles.
#   advanced = hybride BM25 + dense + RRF, puis reranking (défaut)
#   hybrid   = hybride sans reranking
#   basic    = recherche dense seule (pipeline d'origine)
RAG_RETRIEVAL_MODE=advanced
# Reranker multilingue, téléchargé depuis Hugging Face au premier lancement
# (~470 Mo ; si le téléchargement reste bloqué : HF_HUB_DISABLE_XET=1)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MAX_LENGTH=512
# Candidats de la recherche hybride soumis au reranker (moins = plus rapide)
RERANK_CANDIDATES=20

# Escalade automatique quand la confiance RAG est trop faible
#   cosine   = 1 - distance cosinus, seuil RAG_CONFIDENCE_THRESHOLD (défaut)
#   reranker = score du reranker (mode advanced), seuil RAG_RERANK_CONFIDENCE_THRESHOLD
RAG_CONFIDENCE_SIGNAL=cosine
RAG_CONFIDENCE_THRESHOLD=0.35
RAG_RERANK_CONFIDENCE_THRESHOLD=0.045

# WhatsApp Business Cloud API — voir docs/webhooks_ngrok_setup.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Facebook Messenger Platform — voir docs/webhooks_ngrok_setup.md
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=

# Tableau de bord des conseillers (/admin) : un compte par conseiller, en
# base (table agents). Ces deux variables servent UNIQUEMENT à créer le
# premier compte admin au démarrage, si aucun compte n'existe (ensuite, les
# modifier ici n'a plus d'effet). Sans compte en base ni ADMIN_PASSWORD,
# l'API refuse de démarrer. Choisir un vrai mot de passe (valeurs
# ci-dessous = exemple factice).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi-en-production

# CORS : origines web autorisées à appeler l'API depuis un navigateur (et à
# ouvrir le WebSocket /ws), séparées par des virgules.
# Vide = http://localhost:8000,http://127.0.0.1:8000 (suffit pour /chat-demo
# ouvert en local). Pour une page ouverte depuis une autre adresse, y compris
# /chat-demo exposé via ngrok, ajouter son origine exacte :
# CORS_ALLOWED_ORIGINS=http://localhost:8000,https://xxxx.ngrok-free.app
CORS_ALLOWED_ORIGINS=

# Clé de signature des identifiants de session WebSocket (attribués par
# GET /chat/session). Optionnelle : vide = clé aléatoire à chaque démarrage
# (les onglets ouverts doivent être rechargés). À définir avec plusieurs
# processus serveur. Choisir une longue valeur aléatoire (valeur factice ici).
WS_SESSION_SECRET=

# Limitation de débit par adresse IP (réponse 429 au-delà). Valeurs par
# défaut de app/config.py : ces lignes sont optionnelles. Syntaxe de la
# bibliothèque `limits` : "20/minute", "5/10 seconds"...
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_WS_MESSAGES=20/minute
RATE_LIMIT_WS_CONNECTIONS=5
RATE_LIMIT_USERS=10/minute
